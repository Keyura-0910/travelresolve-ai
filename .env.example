# ==============================================================================
# TravelResolve AI - Environment Configuration Example
# Copy this file to .env and adjust variables as required.
# Note: The system runs seamlessly without paid keys using the deterministic
# local template and hashing vector/lexical retriever fallbacks.
# ==============================================================================

# LLM Configuration
# Options: "openai" or "local" (default: "local" when no API key is provided)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings Configuration
# Options: "openai" or "local" (deterministic vectorizer / FAISS local)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Database & Storage
DATABASE_URL=sqlite:///./travelresolve.db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travelresolve-ai
